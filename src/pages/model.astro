---
import Btn from "../components/btn.astro";
import Container from "../components/container.astro";
import PageTitle from "../components/page-title.astro";
import Layout from "../layouts/layout.astro";
import { getSiteUrl } from "../utils/site-url";

const pageTitle = "Повышение эффективности ОПЗ, ОВП, ВПП, ГРП";
const pageDescription =
  "Моделирование и производственные результаты для повышения эффективности ГТМ, снижения затрат и подтверждения план-факт результатов.";

const metrics = [
  {
    value: "10-35%",
    text: "дополнительно к базовому приросту после ОПЗ",
  },
  {
    value: "15-20%",
    text: "снижение затрат на ГТМ при сохранении планового прироста по добыче",
  },
  {
    value: ">85%",
    text: "сходимость «план/факт» по дебиту нефти",
  },
  {
    value: "10%",
    text: "минимальное повышение ЧДД от обработок",
  },
];

const efficiencyLosses = [
  "Повторные ошибки при планировании и проведении ремонтов без программной поддержки",
  "Отсутствие возможности предварительной оценки эффективности технологий",
  "Зависимость результата от компетенций подрядчика, а не от физики пласта",
  "Разрыв «план/факт» >20% при отсутствии калибровки под конкретный геологический объект",
  "Ограниченный бюджет на ГТМ при высоких плановых показателях добычи",
];

const processSteps = [
  "Выбор скважины-кандидата",
  "Подбор технологии и реагентов",
  "Проведение работ",
  "Анализ эффективности",
];

const successItems = [
  "Использование накопленной базы лабораторных экспериментов для быстрого старта работ",
  "Расчет 100+ дизайнов на скважину с определением лучшего плана закачки",
  "Обоснование скважин-кандидатов, авторский надзор над проведением работ, в том числе с выездом на скважину",
  "Анализ эффективности после проведения ГТМ, внедрение лучших практик на предприятии",
];

const cases = [
  {
    title: "Промышленное внедрение Платформы ГТМ",
    results: [
      "Спроектировано >1000 дизайнов СКО",
      "Получен дополнительный прирост в среднем +12% по дебиту нефти",
      "Время на планирование СКО снизилось в 2 раза",
      "Доказана высокая сходимость результатов моделирования с фактическими данными: по приросту дебита нефти - более 90%, по значению скин-фактора - более 87%",
    ],
  },
  {
    title: "Внедрение Симулятора ОПЗ",
    results: [
      "Выполнено моделирование ОПЗ нагнетательного фонда с использованием модуля расчета кольматантов",
      "Проведены дизайны ОПЗ на 30+ скважинах",
      "Получена высокая сходимость результатов моделирования на карбонатных и терригенных коллекторах с фактическими данными по приросту дебита нефти - более 90%",
    ],
  },
];

const actionSteps = [
  "Ретроспектива проведенных работ, подбор скважин-кандидатов на ГТМ",
  "Рамочный договор на моделирование ОПЗ/ОВП/ВПП/ГРП",
  "Инженерное сопровождение и доведение до результата",
  "Аналитический отчет с дизайном работ",
];

const customerResults = [
  "Разработанные цифровые модели скважин",
  "Дополнительная добыча нефти",
  "Снижение операционных затрат",
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={getSiteUrl("/model/", Astro.site)}
>
  <main class="page-main">
    <div class="_model-page">
      <Container>
        <section class="_model-hero">
          <div class="_model-hero__content">
            <p class="_model-page__eyebrow">Моделирование и результат</p>
            <PageTitle
              as="h1"
              rootClass="_model-hero__title"
              mobileAlign="center"
            >
              Повышение эффективности ОПЗ, ОВП, ВПП, ГРП: моделирование и
              производственные результаты
            </PageTitle>
            <p class="_model-hero__description">
              Мы используем свой экспертный опыт и цифровые инструменты,
              гарантируя увеличение технико-экономических результатов ГТМ.
            </p>
            <div class="_model-hero__actions">
              <Btn popovertarget="modal-demo" data-product={pageTitle}>
                Заказать демонстрацию
              </Btn>
            </div>
          </div>
          <div class="_model-hero__aside" aria-label="Год презентации">
            <span>2026</span>
          </div>
        </section>

        <section class="_model-section" aria-labelledby="metrics-title">
          <div class="_model-section__head">
            <p class="_model-page__eyebrow">02</p>
            <h2 id="metrics-title" class="_model-section__title">
              Основные цифры
            </h2>
          </div>
          <div class="_model-metrics">
            {
              metrics.map((item) => (
                <article class="_model-metric">
                  <p class="_model-metric__value">{item.value}</p>
                  <p class="_model-metric__text">{item.text}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section
          class="_model-section _model-section--losses"
          aria-labelledby="losses-title"
        >
          <div class="_model-section__head">
            <p class="_model-page__eyebrow">03</p>
            <h2 id="losses-title" class="_model-section__title">
              Где теряется эффективность от ГТМ?
            </h2>
          </div>
          <div class="_model-losses">
            {
              efficiencyLosses.map((item, index) => (
                <article class="_model-loss">
                  <span class="_model-loss__number">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <p class="_model-loss__text">{item}</p>
                </article>
              ))
            }
          </div>
          <div class="_model-process" aria-label="Процесс ГТМ">
            {
              processSteps.map((item, index) => (
                <div class="_model-process__item">
                  <span class="_model-process__number">{index + 1}</span>
                  <p class="_model-process__text">{item}</p>
                </div>
              ))
            }
          </div>
        </section>

        <section
          class="_model-section _model-section--success"
          aria-labelledby="success-title"
        >
          <div class="_model-section__head">
            <p class="_model-page__eyebrow">04</p>
            <h2 id="success-title" class="_model-section__title">
              Из чего состоит успех сервиса
            </h2>
          </div>
          <div class="_model-success">
            <div class="_model-success__label">
              <span>компетенции</span>
              <span>+</span>
              <span>инженерное ПО</span>
            </div>
            <div class="_model-success__items">
              {
                successItems.map((item) => (
                  <article class="_model-success__item">
                    <p>{item}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </section>

        <section class="_model-section" aria-labelledby="cases-title">
          <div class="_model-section__head">
            <p class="_model-page__eyebrow">07</p>
            <h2 id="cases-title" class="_model-section__title">
              Кейсы компаний
            </h2>
          </div>
          <div class="_model-cases">
            {
              cases.map((item) => (
                <article class="_model-case">
                  <h3 class="_model-card-title">{item.title}</h3>
                  <p class="_model-case__label">Результат:</p>
                  <ul class="_model-list">
                    {item.results.map((result) => (
                      <li>{result}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </section>

        <section
          class="_model-section _model-section--plan"
          aria-labelledby="plan-title"
        >
          <div class="_model-section__head">
            <p class="_model-page__eyebrow">08</p>
            <h2 id="plan-title" class="_model-section__title">План действий</h2>
          </div>
          <div class="_model-action">
            <div class="_model-action__steps">
              {
                actionSteps.map((item, index) => (
                  <article class="_model-action__step">
                    <span class="_model-action__number">{index + 1}</span>
                    <p>{item}</p>
                  </article>
                ))
              }
            </div>
            <aside class="_model-action__result">
              <h3 class="_model-card-title">Что получает заказчик:</h3>
              <ul class="_model-list">
                {customerResults.map((item) => <li>{item}</li>)}
              </ul>
            </aside>
          </div>
        </section>

        <section class="_model-cta" aria-labelledby="cta-title">
          <div class="_model-cta__content">
            <h2 id="cta-title" class="_model-cta__title">
              Оставьте свою заявку, и мы проведем для Вас онлайн-демонстрацию
              сервиса на примере Вашей Компании!
            </h2>
            <Btn popovertarget="modal-demo" data-product={pageTitle}>
              Оставить заявку
            </Btn>
          </div>
          <address class="_model-cta__contacts">
            <p class="_model-cta__person">Ситдиков Марат</p>
            <p>к.т.н., директор</p>
            <a href="tel:+79177919073">+7 917 791 90 73</a>
            <a href="mailto:info@tetacom.pro">info@tetacom.pro</a>
            <a href="https://tetacom.pro">tetacom.pro</a>
          </address>
        </section>
      </Container>
    </div>
  </main>
</Layout>

<style>
  .page-main {
    flex: 1;
  }

  ._model-page {
    padding: 220px 0 150px;
  }

  ._model-page__eyebrow {
    margin: 0;
    color: var(--primary-color);
    font-size: 16px;
    line-height: 1.4em;
    font-weight: 500;
    text-transform: uppercase;
  }

  ._model-hero {
    display: grid;
    gap: 40px;
    align-items: stretch;
  }

  :global(._model-hero__title) {
    margin-top: 28px;
  }

  ._model-hero__description {
    max-width: 760px;
    margin: 45px 0 0;
    font-size: 18px;
    line-height: 1.6em;
  }

  ._model-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 56px;
  }

  ._model-hero__aside {
    display: flex;
    align-items: flex-end;
    min-height: 320px;
    padding: 32px;
    border-radius: 20px;
    background:
      radial-gradient(circle at 78% 20%, rgb(60 93 242 / 18%), transparent 35%),
      #f8f8f8;
  }

  ._model-hero__aside span {
    color: var(--primary-color);
    font-size: 80px;
    line-height: 0.9em;
    font-weight: 500;
  }

  ._model-section {
    margin-top: 160px;
  }

  ._model-section__head {
    display: grid;
    gap: 18px;
  }

  ._model-section__title,
  ._model-cta__title {
    margin: 0;
    font-size: 40px;
    line-height: 47px;
    font-weight: 500;
  }

  ._model-metrics,
  ._model-losses,
  ._model-cases,
  ._model-success__items {
    display: grid;
    gap: 20px;
    margin-top: 56px;
  }

  ._model-metric,
  ._model-loss,
  ._model-success__item,
  ._model-case,
  ._model-action__step,
  ._model-action__result {
    border-radius: 20px;
    background-color: #f8f8f8;
  }

  ._model-metric {
    padding: 32px;
  }

  ._model-metric__value {
    margin: 0;
    color: var(--primary-color);
    font-size: 52px;
    line-height: 1em;
    font-weight: 500;
  }

  ._model-metric__text {
    margin: 28px 0 0;
    font-size: 18px;
    line-height: 1.56em;
  }

  ._model-loss {
    padding: 28px;
  }

  ._model-loss__number {
    color: var(--primary-color);
    font-size: 14px;
    line-height: 1em;
    font-weight: 500;
  }

  ._model-loss__text,
  ._model-success__item p,
  ._model-action__step p {
    margin: 24px 0 0;
    font-size: 18px;
    line-height: 1.56em;
  }

  ._model-process {
    display: grid;
    gap: 20px;
    margin-top: 20px;
    padding: 28px;
    border: 2px solid var(--black-color);
    border-radius: 20px;
  }

  ._model-process__item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  ._model-process__number,
  ._model-action__number {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: var(--primary-color);
    color: var(--white-color);
    font-size: 16px;
    line-height: 1em;
    font-weight: 500;
  }

  ._model-process__text {
    margin: 0;
    font-size: 18px;
    line-height: 1.4em;
    font-weight: 500;
  }

  ._model-success {
    display: grid;
    gap: 20px;
    margin-top: 56px;
  }

  ._model-success__label {
    display: grid;
    align-content: center;
    justify-items: center;
    min-height: 260px;
    padding: 32px;
    border-radius: 20px;
    background-color: var(--primary-color);
    color: var(--white-color);
    text-align: center;
    font-size: 32px;
    line-height: 1.2em;
    font-weight: 500;
  }

  ._model-success__item {
    padding: 28px;
  }

  ._model-success__item p {
    margin-top: 0;
  }

  ._model-case {
    padding: 32px;
  }

  ._model-card-title {
    margin: 0;
    font-size: 28px;
    line-height: 1.25em;
  }

  ._model-case__label {
    margin: 40px 0 0;
    color: var(--primary-color);
    font-size: 18px;
    line-height: 1.4em;
    font-weight: 500;
  }

  ._model-list {
    display: grid;
    gap: 16px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  ._model-list li {
    position: relative;
    padding-left: 24px;
    font-size: 18px;
    line-height: 1.56em;
  }

  ._model-list li::before {
    content: "";
    position: absolute;
    top: 0.72em;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--primary-color);
  }

  ._model-action {
    display: grid;
    gap: 20px;
    margin-top: 56px;
  }

  ._model-action__steps {
    display: grid;
    gap: 20px;
  }

  ._model-action__step,
  ._model-action__result {
    padding: 28px;
  }

  ._model-action__step p {
    margin-top: 28px;
  }

  ._model-action__result {
    background-color: var(--black-color);
    color: var(--white-color);
  }

  ._model-action__result ._model-list li::before {
    background-color: var(--white-color);
  }

  ._model-cta {
    display: grid;
    gap: 40px;
    margin-top: 160px;
    padding: 60px;
    border-radius: 20px;
    background-color: #f8f8f8;
  }

  ._model-cta__content {
    display: grid;
    align-content: start;
    gap: 40px;
  }

  ._model-cta__contacts {
    display: grid;
    gap: 12px;
    margin: 0;
    font-size: 20px;
    font-style: normal;
    line-height: 1.4em;
  }

  ._model-cta__contacts p {
    margin: 0;
  }

  ._model-cta__person {
    font-size: 28px;
    line-height: 1.2em;
    font-weight: 500;
  }

  ._model-cta__contacts a {
    color: inherit;
    transition: color var(--delay) var(--timing-func);
  }

  ._model-cta__contacts a:hover {
    color: var(--primary-color);
  }

  /* mobile */
  @media (width < 769px) {
    ._model-page {
      padding: 80px 0;
    }

    ._model-page__eyebrow {
      text-align: center;
    }

    :global(._model-hero__title) {
      margin-top: 20px;
    }

    ._model-hero__description {
      margin-top: 32px;
      text-align: center;
    }

    ._model-hero__actions {
      justify-content: center;
      margin-top: 40px;
    }

    ._model-hero__aside {
      min-height: 180px;
      padding: 24px;
    }

    ._model-hero__aside span {
      font-size: 56px;
    }

    ._model-section,
    ._model-cta {
      margin-top: 80px;
    }

    ._model-section__title,
    ._model-cta__title {
      font-size: 32px;
      line-height: 1.2em;
      text-align: center;
    }

    ._model-metrics,
    ._model-losses,
    ._model-cases,
    ._model-success,
    ._model-success__items,
    ._model-action {
      margin-top: 36px;
    }

    ._model-metric,
    ._model-loss,
    ._model-case,
    ._model-action__step,
    ._model-action__result,
    ._model-process,
    ._model-success__item {
      padding: 20px;
      border-radius: 16px;
    }

    ._model-metric__value {
      font-size: 42px;
    }

    ._model-success__label {
      min-height: 200px;
      padding: 24px;
      border-radius: 16px;
      font-size: 26px;
    }

    ._model-card-title,
    ._model-cta__person {
      font-size: 24px;
    }

    ._model-cta {
      padding: 24px;
      border-radius: 16px;
    }

    ._model-cta__contacts {
      font-size: 18px;
    }
  }

  /* tablet */
  @media (width >= 769px) {
    ._model-hero {
      grid-template-columns: 1fr 320px;
    }

    ._model-metrics,
    ._model-losses,
    ._model-success__items,
    ._model-action__steps {
      grid-template-columns: repeat(2, 1fr);
    }

    ._model-cases,
    ._model-action,
    ._model-cta {
      grid-template-columns: repeat(2, 1fr);
    }

    ._model-process {
      grid-template-columns: repeat(4, 1fr);
    }

    ._model-process__item {
      flex-direction: column;
    }
  }

  /* tablet-only */
  @media (width >= 769px) and (width < 1081px) {
    ._model-page {
      padding: 120px 0;
    }

    ._model-section,
    ._model-cta {
      margin-top: 120px;
    }
  }

  /* desktop */
  @media (width >= 1081px) {
    ._model-hero {
      grid-template-columns: 1fr 400px;
      gap: 80px;
    }

    ._model-section--losses ._model-section__head,
    ._model-section--success ._model-section__head,
    ._model-section--plan ._model-section__head {
      max-width: 760px;
    }

    ._model-metrics {
      grid-template-columns: repeat(4, 1fr);
    }

    ._model-losses {
      grid-template-columns: repeat(5, 1fr);
    }

    ._model-success {
      grid-template-columns: 360px 1fr;
    }

    ._model-success__items {
      margin-top: 0;
    }

    ._model-action {
      grid-template-columns: 1fr 380px;
    }

    ._model-cta {
      align-items: end;
      grid-template-columns: 1fr 360px;
    }
  }
</style>
