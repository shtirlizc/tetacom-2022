---
import Btn from "../components/btn.astro";
import Container from "../components/container.astro";
import PageTitle from "../components/page-title.astro";
import Layout from "../layouts/layout.astro";
import { getSiteUrl } from "../utils/site-url";

const pageTitle = "Повышение эффективности ОПЗ, ОВП, ВПП, ГРП";
const pageDescription =
  "Моделирование и производственные результаты для повышения эффективности ГТМ, снижения затрат и подтверждения план-факт результатов.";

const metrics = [
  {
    value: "10-35%",
    text: "дополнительно к базовому приросту после ОПЗ",
  },
  {
    value: "15-20%",
    text: "снижение затрат на ГТМ при сохранении планового прироста по добыче",
  },
  {
    value: ">85%",
    text: "сходимость «план/факт» по дебиту нефти",
  },
  {
    value: "10%",
    text: "минимальное повышение ЧДД от обработок",
  },
];

const heroTags = ["ОПЗ", "ОВП", "ВПП", "ГРП"];

const heroPanelItems = [
  {
    value: "100+",
    text: "дизайнов на скважину",
  },
  {
    value: "90%+",
    text: "сходимость по приросту дебита",
  },
  {
    value: "2x",
    text: "быстрее планирование СКО",
  },
];

const modelStages = ["Кандидат", "Дизайн", "Проведение", "План-факт"];

const efficiencyLosses = [
  "Повторные ошибки при планировании и проведении ремонтов без программной поддержки",
  "Отсутствие возможности предварительной оценки эффективности технологий",
  "Зависимость результата от компетенций подрядчика, а не от физики пласта",
  "Разрыв «план/факт» >20% при отсутствии калибровки под конкретный геологический объект",
  "Ограниченный бюджет на ГТМ при высоких плановых показателях добычи",
];

const processSteps = [
  "Выбор скважины-кандидата",
  "Подбор технологии и реагентов",
  "Проведение работ",
  "Анализ эффективности",
];

const successItems = [
  "Использование накопленной базы лабораторных экспериментов для быстрого старта работ",
  "Расчет 100+ дизайнов на скважину с определением лучшего плана закачки",
  "Обоснование скважин-кандидатов, авторский надзор над проведением работ, в том числе с выездом на скважину",
  "Анализ эффективности после проведения ГТМ, внедрение лучших практик на предприятии",
];

const cases = [
  {
    title: "Промышленное внедрение Платформы ГТМ",
    results: [
      "Спроектировано >1000 дизайнов СКО",
      "Получен дополнительный прирост в среднем +12% по дебиту нефти",
      "Время на планирование СКО снизилось в 2 раза",
      "Доказана высокая сходимость результатов моделирования с фактическими данными: по приросту дебита нефти - более 90%, по значению скин-фактора - более 87%",
    ],
  },
  {
    title: "Внедрение Симулятора ОПЗ",
    results: [
      "Выполнено моделирование ОПЗ нагнетательного фонда с использованием модуля расчета кольматантов",
      "Проведены дизайны ОПЗ на 30+ скважинах",
      "Получена высокая сходимость результатов моделирования на карбонатных и терригенных коллекторах с фактическими данными по приросту дебита нефти - более 90%",
    ],
  },
];

const actionSteps = [
  "Ретроспектива проведенных работ, подбор скважин-кандидатов на ГТМ",
  "Рамочный договор на моделирование ОПЗ/ОВП/ВПП/ГРП",
  "Инженерное сопровождение и доведение до результата",
  "Аналитический отчет с дизайном работ",
];

const customerResults = [
  "Разработанные цифровые модели скважин",
  "Дополнительная добыча нефти",
  "Снижение операционных затрат",
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={getSiteUrl("/model/", Astro.site)}
>
  <main class="page-main">
    <div class="_model-page">
      <Container>
        <section class="_model-hero">
          <div class="_model-hero__content">
            <p class="_model-page__eyebrow">Моделирование и результат</p>
            <PageTitle
              as="h1"
              rootClass="_model-hero__title"
              mobileAlign="left"
            >
              Повышение эффективности ОПЗ, ОВП, ВПП и ГРП
            </PageTitle>
            <p class="_model-hero__description">
              Мы используем свой экспертный опыт и цифровые инструменты,
              гарантируя увеличение технико-экономических результатов ГТМ.
            </p>
            <div class="_model-hero__actions">
              <Btn popovertarget="modal-demo" data-product={pageTitle}>
                Заказать демонстрацию
              </Btn>
            </div>
          </div>
          <div
            class="_model-hero__aside"
            aria-label="Показатели моделирования ГТМ"
          >
            <div class="_model-hero-panel">
              <div class="_model-hero-panel__top">
                <span>Платформа ГТМ</span>
                <ul
                  class="_model-hero__tags"
                  aria-label="Направления моделирования"
                >
                  {heroTags.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <img
                class="_model-hero-panel__image"
                src="/cover.jpg"
                alt="Визуализация аналитики и цифрового моделирования Тетаком"
                loading="eager"
                decoding="async"
              />
              <div class="_model-hero-panel__gauge">
                <p class="_model-hero-panel__value">&gt;85%</p>
                <p>сходимость план-факт по дебиту нефти</p>
              </div>
              <div class="_model-hero-panel__flow" aria-hidden="true">
                {modelStages.map((item) => <span>{item}</span>)}
              </div>
              <div class="_model-hero-panel__items">
                {
                  heroPanelItems.map((item) => (
                    <div class="_model-hero-panel__item">
                      <strong>{item.value}</strong>
                      <span>{item.text}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </section>

        <section class="_model-section" aria-labelledby="metrics-title">
          <div class="_model-section__head">
            <h2 id="metrics-title" class="_model-section__title">
              Основные цифры
            </h2>
          </div>
          <div class="_model-metrics">
            {
              metrics.map((item) => (
                <article class="_model-metric">
                  <p class="_model-metric__value">{item.value}</p>
                  <p class="_model-metric__text">{item.text}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section
          class="_model-section _model-section--losses"
          aria-labelledby="losses-title"
        >
          <div class="_model-section__head">
            <h2 id="losses-title" class="_model-section__title">
              Где теряется эффективность от ГТМ?
            </h2>
          </div>
          <div class="_model-losses">
            {
              efficiencyLosses.map((item, index) => (
                <article class="_model-loss">
                  <span class="_model-loss__number">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <p class="_model-loss__text">{item}</p>
                </article>
              ))
            }
          </div>
          <div class="_model-process" aria-label="Процесс ГТМ">
            {
              processSteps.map((item, index) => (
                <div class="_model-process__item">
                  <span class="_model-process__number">{index + 1}</span>
                  <p class="_model-process__text">{item}</p>
                </div>
              ))
            }
          </div>
        </section>

        <section
          class="_model-section _model-section--success"
          aria-labelledby="success-title"
        >
          <div class="_model-section__head">
            <h2 id="success-title" class="_model-section__title">
              Из чего состоит успех сервиса
            </h2>
          </div>
          <div class="_model-success">
            <div class="_model-success__label">
              <span>компетенции</span>
              <span>+</span>
              <span>инженерное ПО</span>
            </div>
            <div class="_model-success__items">
              {
                successItems.map((item) => (
                  <article class="_model-success__item">
                    <p>{item}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </section>

        <section class="_model-section" aria-labelledby="cases-title">
          <div class="_model-section__head">
            <h2 id="cases-title" class="_model-section__title">
              Кейсы компаний
            </h2>
          </div>
          <div class="_model-cases">
            {
              cases.map((item) => (
                <article class="_model-case">
                  <h3 class="_model-card-title">{item.title}</h3>
                  <p class="_model-case__label">Результат:</p>
                  <ul class="_model-list">
                    {item.results.map((result) => (
                      <li>{result}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </section>

        <section
          class="_model-section _model-section--plan"
          aria-labelledby="plan-title"
        >
          <div class="_model-section__head">
            <h2 id="plan-title" class="_model-section__title">План действий</h2>
          </div>
          <div class="_model-action">
            <div class="_model-action__steps">
              {
                actionSteps.map((item, index) => (
                  <article class="_model-action__step">
                    <span class="_model-action__number">{index + 1}</span>
                    <p>{item}</p>
                  </article>
                ))
              }
            </div>
            <aside class="_model-action__result">
              <h3 class="_model-card-title">Что получает заказчик:</h3>
              <ul class="_model-list">
                {customerResults.map((item) => <li>{item}</li>)}
              </ul>
            </aside>
          </div>
        </section>

        <section class="_model-cta" aria-labelledby="cta-title">
          <div class="_model-cta__content">
            <div>
              <h2 id="cta-title" class="_model-cta__title">
                Покажем расчет на вашем примере
              </h2>
              <p class="_model-cta__description">
                Проведем онлайн-демонстрацию сервиса на данных, близких к вашим
                задачам.
              </p>
            </div>
            <div>
              <Btn popovertarget="modal-demo" data-product={pageTitle}>
                Заказать демонстрацию
              </Btn>
            </div>
          </div>
        </section>
      </Container>
    </div>
  </main>
</Layout>

<style>
  .page-main {
    flex: 1;
  }

  ._model-page {
    --model-ink: #101624;
    --model-muted: rgb(16 22 36 / 68%);
    --model-line: rgb(36 49 88 / 10%);
    --model-surface: rgb(255 255 255 / 90%);
    --model-radius: 22px;

    position: relative;
    overflow: hidden;
    padding: clamp(104px, 10vw, 156px) 0 clamp(84px, 9vw, 132px);
    background:
      linear-gradient(135deg, rgb(60 93 242 / 9%) 0%, transparent 36%),
      linear-gradient(180deg, #f8faff 0%, #fdfefe 42%, #f3f6fb 100%);
    color: var(--model-ink);
  }

  ._model-page::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 620px;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(60 93 242 / 7%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(60 93 242 / 7%) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(180deg, #111 0%, transparent 72%);
  }

  ._model-page :global(._container) {
    position: relative;
    z-index: 1;
  }

  ._model-page__eyebrow {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    margin: 0;
    padding: 9px 15px;
    border: 1px solid rgb(60 93 242 / 22%);
    border-radius: 999px;
    background-color: rgb(255 255 255 / 84%);
    color: var(--primary-color);
    font-size: 13px;
    line-height: 1;
    font-weight: 600;
    box-shadow: 0 14px 36px rgb(24 40 96 / 7%);
  }

  ._model-hero {
    display: grid;
    gap: clamp(34px, 6vw, 78px);
    align-items: center;
    min-height: min(720px, calc(100dvh - 128px));
  }

  ._model-hero__content {
    max-width: 720px;
  }

  :global(._model-hero__title) {
    max-width: 760px;
    margin-top: 24px;
    color: var(--model-ink);
    font-size: clamp(42px, 5vw, 68px);
    line-height: 0.98em;
    letter-spacing: -0.055em;
  }

  ._model-hero__description {
    max-width: 650px;
    margin: 28px 0 0;
    color: var(--model-muted);
    font-size: clamp(17px, 1.45vw, 21px);
    line-height: 1.55em;
  }

  ._model-hero__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ._model-hero__tags li {
    padding: 7px 10px;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 999px;
    background-color: rgb(255 255 255 / 10%);
    color: rgb(255 255 255 / 82%);
    font-size: 12px;
    line-height: 1;
    font-weight: 600;
  }

  ._model-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 36px;
  }

  ._model-hero__aside {
    position: relative;
    min-height: 600px;
    padding: 12px;
    overflow: hidden;
    border: 1px solid rgb(22 32 68 / 9%);
    border-radius: calc(var(--model-radius) + 8px);
    color: var(--white-color);
    background: linear-gradient(
      145deg,
      rgb(16 22 36 / 98%) 0%,
      rgb(25 39 95 / 98%) 62%,
      rgb(60 93 242 / 96%) 100%
    );
    box-shadow: 0 34px 88px rgb(27 40 82 / 22%);
  }

  ._model-hero__aside::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 8%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 8%) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(circle at 58% 34%, #111 0%, transparent 72%);
    pointer-events: none;
  }

  ._model-hero-panel {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: 100%;
    grid-template-rows: auto auto 1fr auto auto;
    gap: 22px;
    padding: clamp(18px, 2.4vw, 28px);
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: var(--model-radius);
    background-color: rgb(255 255 255 / 12%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 18%);
    backdrop-filter: blur(10px);
  }

  ._model-hero-panel__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    color: rgb(255 255 255 / 82%);
    font-size: 13px;
    line-height: 1.2em;
    font-weight: 600;
  }

  ._model-hero-panel__image {
    display: block;
    width: 100%;
    aspect-ratio: 1.82;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 16px;
    object-fit: cover;
    object-position: center;
    box-shadow: 0 22px 48px rgb(7 12 31 / 22%);
  }

  ._model-hero-panel__gauge p {
    max-width: 290px;
    margin: 10px 0 0;
    color: rgb(255 255 255 / 78%);
    font-size: 16px;
    line-height: 1.45em;
  }

  ._model-hero-panel__value {
    margin: 0;
    color: var(--white-color);
    font-size: clamp(58px, 7vw, 84px);
    line-height: 0.95em;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  ._model-hero-panel__flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border-radius: 16px;
    background-color: rgb(4 10 28 / 22%);
  }

  ._model-hero-panel__flow span {
    min-height: 70px;
    padding: 16px 12px;
    background-color: rgb(255 255 255 / 9%);
    color: rgb(255 255 255 / 82%);
    font-size: 12px;
    line-height: 1.25em;
    font-weight: 600;
  }

  ._model-hero-panel__items {
    display: grid;
    gap: 14px;
  }

  ._model-hero-panel__item {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: 14px;
    align-items: center;
    padding-top: 14px;
    border-top: 1px solid rgb(255 255 255 / 18%);
  }

  ._model-hero-panel__item strong {
    font-size: 26px;
    line-height: 1em;
    font-weight: 600;
  }

  ._model-hero-panel__item span {
    color: rgb(255 255 255 / 74%);
    font-size: 13px;
    line-height: 1.35em;
  }

  ._model-section {
    margin-top: clamp(82px, 9vw, 138px);
  }

  ._model-section__head {
    display: grid;
    gap: 16px;
  }

  ._model-section__title,
  ._model-cta__title {
    max-width: 820px;
    margin: 0;
    color: var(--model-ink);
    font-size: clamp(30px, 3.6vw, 46px);
    line-height: 1.16em;
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  ._model-metrics,
  ._model-losses,
  ._model-cases,
  ._model-success__items {
    display: grid;
    gap: 20px;
    margin-top: 34px;
  }

  ._model-metric,
  ._model-loss,
  ._model-success__item,
  ._model-case,
  ._model-action__step,
  ._model-action__result {
    border: 1px solid var(--model-line);
    border-radius: var(--model-radius);
    background-color: var(--model-surface);
    box-shadow: 0 18px 48px rgb(25 39 91 / 7%);
  }

  ._model-metric {
    position: relative;
    overflow: hidden;
    min-height: 250px;
    padding: 28px;
  }

  ._model-metric::after {
    content: "";
    position: absolute;
    right: -48px;
    bottom: -48px;
    width: 150px;
    height: 150px;
    border-radius: 999px;
    background: rgb(60 93 242 / 8%);
  }

  ._model-metric__value {
    position: relative;
    z-index: 1;
    margin: 0;
    color: var(--primary-color);
    font-size: clamp(42px, 5vw, 64px);
    line-height: 1em;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  ._model-metric__text {
    position: relative;
    z-index: 1;
    margin: 24px 0 0;
    color: var(--model-muted);
    font-size: 17px;
    line-height: 1.55em;
  }

  ._model-loss {
    display: grid;
    align-content: start;
    min-height: 210px;
    padding: 26px;
  }

  ._model-loss__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-width: 44px;
    min-height: 34px;
    padding: 8px 12px;
    border-radius: 14px;
    background-color: rgb(60 93 242 / 9%);
    color: var(--primary-color);
    font-size: 13px;
    line-height: 1em;
    font-weight: 600;
  }

  ._model-loss__text,
  ._model-success__item p,
  ._model-action__step p {
    margin: 24px 0 0;
    color: var(--model-muted);
    font-size: 17px;
    line-height: 1.58em;
  }

  ._model-process {
    display: grid;
    gap: 0;
    margin-top: 20px;
    overflow: hidden;
    border: 1px solid rgb(60 93 242 / 16%);
    border-radius: var(--model-radius);
    background-color: #fdfefe;
    box-shadow: 0 18px 48px rgb(25 39 91 / 7%);
  }

  ._model-process__item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 24px;
  }

  ._model-process__item + ._model-process__item {
    border-top: 1px solid var(--model-line);
  }

  ._model-process__number,
  ._model-action__number {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 14px;
    background-color: var(--primary-color);
    color: var(--white-color);
    font-size: 16px;
    line-height: 1em;
    font-weight: 600;
    box-shadow: 0 12px 26px rgb(60 93 242 / 28%);
  }

  ._model-process__text {
    margin: 0;
    color: var(--model-ink);
    font-size: 17px;
    line-height: 1.4em;
    font-weight: 600;
  }

  ._model-success {
    display: grid;
    gap: 20px;
    margin-top: 34px;
  }

  ._model-success__label {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    min-height: 300px;
    overflow: hidden;
    padding: 32px;
    border-radius: var(--model-radius);
    background: linear-gradient(
      145deg,
      #162457 0%,
      #2b48c4 64%,
      var(--primary-color) 100%
    );
    color: var(--white-color);
    text-align: center;
    font-size: clamp(27px, 3vw, 38px);
    line-height: 1.18em;
    font-weight: 600;
    box-shadow: 0 24px 58px rgb(60 93 242 / 20%);
  }

  ._model-success__label::before {
    content: "";
    position: absolute;
    inset: 24px;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 16px;
    pointer-events: none;
  }

  ._model-success__label span {
    position: relative;
    z-index: 1;
  }

  ._model-success__item {
    padding: 28px;
    box-shadow: none;
  }

  ._model-success__item p {
    margin-top: 0;
  }

  ._model-case {
    display: grid;
    align-content: start;
    padding: clamp(26px, 3vw, 36px);
  }

  ._model-card-title {
    margin: 0;
